{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predictions-cup.local/schemas/exposure-groups-v1.schema.json",
  "title": "Predictions Cup exposure-group registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "generated_from",
    "hash_scope",
    "content_sha256",
    "coverage",
    "memberships"
  ],
  "properties": {
    "schema_version": {
      "const": "exposure-groups-v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_from": {
      "type": "object"
    },
    "hash_scope": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "object"
    },
    "memberships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "market_id",
          "tournament_id",
          "group_ids",
          "provenance"
        ],
        "properties": {
          "market_id": {
            "type": "string",
            "minLength": 1
          },
          "tournament_id": {
            "type": "string",
            "minLength": 1
          },
          "group_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "group_id",
                "source",
                "basis"
              ],
              "properties": {
                "group_id": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "basis": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
