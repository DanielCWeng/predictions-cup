# Complete bot pseudocode

```python
TICK = venue_tick

LAMBDA_INV = 0.16
LOCAL_WEIGHT = 0.10

MIN_TAKE_EDGE = 3 * TICK
RELATED_TAKE_EDGE = 5 * TICK

MAX_REF_AGE_TAKE = 10.0
MAX_REF_AGE_MAKE = 30.0

REQUOTE_MOVE = 0.5 * TICK
CANCEL_MOVE = 1.0 * TICK

FRACTIONAL_KELLY = 0.10

SOFT_INV = 0.60
STOP_ADD_INV = 0.80
HARD_INV = 0.95

MAX_TOUCH_SHARE = 0.25


def sigmoid(z):
    return 1 / (1 + exp(-z))


def logit(p):
    p = clip(p, 0.01, 0.99)
    return log(p / (1 - p))


def microprice(book):
    bid = book.best_bid
    ask = book.best_ask

    bq = book.best_bid_size
    aq = book.best_ask_size

    return (ask * bq + bid * aq) / (bq + aq)


def external_fair_value(market):
    observations = []

    for ref in market.external_refs:

        if not equivalent_resolution(market, ref):
            continue

        p = microprice(ref.book)

        freshness = freshness_score(ref.age)
        liquidity = liquidity_score(ref.book)
        spread_score = spread_quality(ref.book)
        mapping = ref.mapping_confidence

        weight = (
            freshness
            * liquidity
            * spread_score
            * mapping
        )

        observations.append(
            (logit(p), weight)
        )

    if not observations:
        return None

    z = weighted_average(observations)

    return sigmoid(z)


def related_market_adjustment(market):

    dz = 0.0

    for rel in market.relations:

        if rel.type == "EQUIVALENT":
            continue  # handled as external/direct reference

        elif rel.type == "COMPLEMENT":
            apply_exact_constraint(rel)

        elif rel.type == "MUTUALLY_EXCLUSIVE":
            apply_simplex_constraint(rel.group)

        elif rel.type == "MONOTONIC":
            apply_isotonic_constraint(rel.group)

        elif rel.type == "STATISTICAL":

            change = rel.other.external_logit_change

            predicted = rel.beta * change

            predicted = cap_probability_effect(
                predicted,
                max_probability_move=0.03
            )

            dz += predicted

    return dz


def fair_value(market):

    ext = external_fair_value(market)

    if ext is None:
        return None

    z = logit(ext)

    # Competition market is deliberately low-weight.
    if market.local_book.valid:
        local = microprice(market.local_book)

        local_residual = clip(
            logit(local) - z,
            -0.20,
            +0.20
        )

        z += LOCAL_WEIGHT * local_residual

    z += related_market_adjustment(market)

    F = sigmoid(z)

    F = enforce_hard_constraints(
        market,
        F
    )

    return F


def effective_inventory(market):

    own = market.position / market.position_limit

    group = (
        market.group_exposure
        / market.group_limit
    )

    return clip(
        own + 0.50 * group,
        -1.5,
        +1.5
    )


def reservation_price(market, F):

    x = effective_inventory(market)

    return sigmoid(
        logit(F) - LAMBDA_INV * x
    )


def required_halfspread(market):

    ext_spread = market.external_spread
    sigma5 = market.external_volatility_5s

    h = (
        TICK
        + 0.5 * ext_spread
        + 1.25 * sigma5
        + market.toxicity_penalty
        + market.staleness_penalty
        + market.disagreement_penalty
    )

    return max(TICK, h)


def taker_edge(market, h):

    return max(
        MIN_TAKE_EDGE,
        2.0 * h
    )


def fractional_kelly_size(F, price, bankroll):

    edge = F - price

    if edge <= 0:
        return 0

    full_kelly_contracts = (
        bankroll
        * edge
        / (price * (1 - price))
    )

    return FRACTIONAL_KELLY * full_kelly_contracts


def passive_size(market, side):

    base = market.base_quote_size

    x = (
        market.position
        / market.position_limit
    )

    if side == "BUY":
        inv_multiplier = clip(
            1 - 0.75 * x,
            0.25,
            1.75
        )

        room = (
            market.position_limit
            - market.position
        )

        depth = (
            MAX_TOUCH_SHARE
            * market.local_book.best_bid_size
        )

    else:
        inv_multiplier = clip(
            1 + 0.75 * x,
            0.25,
            1.75
        )

        room = (
            market.position_limit
            + market.position
        )

        depth = (
            MAX_TOUCH_SHARE
            * market.local_book.best_ask_size
        )

    toxicity_multiplier = (
        1 - 0.75 * market.toxicity_score
    )

    size = (
        base
        * inv_multiplier
        * toxicity_multiplier
    )

    return max(
        0,
        min(size, room, depth)
    )


def maybe_take(market, F, R, h):

    book = market.local_book

    threshold = taker_edge(market, h)

    # BUY CHEAP CONTRACTS
    buy_edge = R - book.best_ask

    if buy_edge >= threshold:

        size = fractional_kelly_size(
            F,
            book.best_ask,
            portfolio.bankroll
        )

        size = risk_cap_buy(
            market,
            size
        )

        if size > 0:
            send_IOC_buy(
                market,
                book.best_ask,
                size
            )

    # SELL EXPENSIVE CONTRACTS
    sell_edge = book.best_bid - R

    if sell_edge >= threshold:

        # Equivalent Kelly calculation
        # from the NO / short perspective.
        size = short_kelly_size(
            F,
            book.best_bid,
            portfolio.bankroll
        )

        size = risk_cap_sell(
            market,
            size
        )

        if size > 0:
            send_IOC_sell(
                market,
                book.best_bid,
                size
            )


def build_passive_quotes(market, R, h):

    book = market.book_excluding_our_orders()

    max_bid = floor_tick(R - h)
    min_ask = ceil_tick(R + h)

    bid_price = None
    ask_price = None

    # BID
    if market.position < (
        STOP_ADD_INV * market.position_limit
    ):

        if max_bid >= book.best_bid + TICK:
            bid_price = book.best_bid + TICK

        elif max_bid >= book.best_bid:
            bid_price = book.best_bid

    # ASK
    if market.position > (
        -STOP_ADD_INV * market.position_limit
    ):

        if min_ask <= book.best_ask - TICK:
            ask_price = book.best_ask - TICK

        elif min_ask <= book.best_ask:
            ask_price = book.best_ask

    return bid_price, ask_price


def refresh_market(market):

    if market.external_reference_age > MAX_REF_AGE_MAKE:
        cancel_all(market)
        return

    F = fair_value(market)

    if F is None:
        cancel_all(market)
        return

    R = reservation_price(market, F)

    h = required_halfspread(market)

    # TAKE FIRST.
    if (
        market.external_reference_age
        <= MAX_REF_AGE_TAKE
    ):
        maybe_take(
            market,
            F,
            R,
            h
        )

    # THEN PASSIVELY MAKE.
    bid_price, ask_price = (
        build_passive_quotes(
            market,
            R,
            h
        )
    )

    bid_size = passive_size(
        market,
        "BUY"
    )

    ask_size = passive_size(
        market,
        "SELL"
    )

    reconcile_order(
        market,
        side="BUY",
        price=bid_price,
        size=bid_size
    )

    reconcile_order(
        market,
        side="SELL",
        price=ask_price,
        size=ask_size
    )

    market.last_fair_value = F
    market.last_reservation = R


def on_external_market_update(ref):

    update_reference_state(ref)

    for market in markets_using(ref):

        old_F = market.last_fair_value

        new_F = preview_fair_value(market)

        if old_F is None:
            refresh_market(market)
            continue

        move = abs(new_F - old_F)

        # Stale resting quotes are dangerous.
        if move >= CANCEL_MOVE:
            cancel_all(market)

        if move >= REQUOTE_MOVE:
            refresh_market(market)


def on_related_market_update(source):

    for target in source.related_markets:

        predicted_move = (
            target.relationship.beta
            * source.external_logit_change
        )

        if probability_equivalent(
            predicted_move
        ) >= TICK:

            cancel_all(target)
            refresh_market(target)


def on_competition_book_update(market):

    update_local_book(market)

    refresh_market(market)


def on_fill(fill):

    market = fill.market

    # Inventory is authoritative immediately.
    update_position(fill)

    # Don't blindly reload a stale quote.
    cancel_all(market)

    market.pending_fill_evaluation.append({
        "time": now(),
        "side": fill.side,
        "price": fill.price,
        "reference_at_fill":
            market.current_external_fair
    })

    refresh_market(market)


def evaluate_fill_toxicity(market):

    for fill in fills_older_than(
        market,
        seconds=2
    ):

        ref_now = market.current_external_fair

        if fill.side == "BUY":
            adverse = (
                ref_now
                < fill.reference_at_fill - TICK
            )

        else:
            adverse = (
                ref_now
                > fill.reference_at_fill + TICK
            )

        market.toxicity_score = (
            0.90
            * market.toxicity_score
            + 0.10
            * int(adverse)
        )

        market.toxicity_penalty = (
            3
            * TICK
            * market.toxicity_score
        )


def risk_loop():

    for market in all_markets:

        x = abs(
            market.position
            / market.position_limit
        )

        if x >= HARD_INV:
            actively_reduce_inventory(
                market,
                target_fraction=0.70
            )

        elif x >= STOP_ADD_INV:
            disable_inventory_increasing_side(
                market
            )

    enforce_group_limits()
    enforce_total_exposure_limit()


def main():

    load_market_mapping()
    load_external_mapping()
    load_relationship_graph()
    load_relation_betas()

    connect_competition_websocket()
    connect_external_websockets()

    while True:

        event = next_event()

        if event.type == "EXTERNAL_BOOK":
            on_external_market_update(
                event.reference
            )

        elif event.type == "LOCAL_BOOK":
            on_competition_book_update(
                event.market
            )

        elif event.type == "FILL":
            on_fill(
                event.fill
            )

        elif event.type == "RELATED_MOVE":
            on_related_market_update(
                event.market
            )

        every_1_second:
            evaluate_all_fill_toxicity()
            risk_loop()

        every_30_seconds:
            sanity_check_references()
            remove_stale_orders()
            verify_positions()
```

## What I would actually prioritise over the next few days

The competitive advantage here isn't some exotic pricing formula. It is getting **four things extremely reliable**:

**Reference mapping → instantaneous fair-value propagation → safe execution → inventory control.**

If I had to strip the system down even further, I would preserve the direct external fair value, 3-cent taker rule, inventory-skewed reservation price, selective maker quotes, and immediate cancel/reprice on reference moves.

The crucial behavioural rule is:

> **Our orders are expressions of fair value, not commitments. The instant the information that justified an order changes, the order disappears.**

That is the bot I would actually enter.

