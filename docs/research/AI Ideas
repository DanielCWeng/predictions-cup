def estimate_microprice(market):

    levels = 3

    bid_levels = sorted(
        market.bids.items(),
        reverse=True
    )[:levels]

    ask_levels = sorted(
        market.asks.items()
    )[:levels]

    numerator = 0.0
    denominator = 0.0

    for level in range(min(len(bid_levels), len(ask_levels))):

        bid_p, bid_size = bid_levels[level]
        ask_p, ask_size = ask_levels[level]

        weight = math.exp(-0.8 * level)

        micro = (
            ask_p * bid_size
            + bid_p * ask_size
        ) / max(bid_size + ask_size, 1e-9)

        numerator += weight * micro
        denominator += weight

    return numerator / denominator


def related_fair(market, now, external_prob):

    if external_prob is None:
        return None

    x = logit(external_prob)

    for rel in market.related:

        # short-horizon move of related contract
        dx = (
            logit(rel.current_prob)
            - logit(rel.reference_prob)
        )

        x += rel.beta * dx

    return sigmoid(x)


