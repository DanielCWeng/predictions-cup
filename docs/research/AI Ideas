    ext, dispersion = estimate_external_fair(
        market, now
    )

    micro = estimate_microprice(market)

    rel = related_fair(
        market,
        now,
        ext
    )

    if ext is None:
        # no trustworthy external anchor
        return None

    x_ext = logit(ext)
    x_rel = logit(rel if rel is not None else ext)
    x_micro = logit(micro)

    # external anchor dominates
    x_fair = (
        0.55 * x_ext
        + 0.30 * x_rel
        + 0.15 * x_micro
    )

    market.external_prob = ext
    market.related_prob = rel
    market.micro_prob = micro
    market.fair_prob = sigmoid(x_fair)
    market.source_dispersion = dispersion

    return market.fair_prob


def inventory_center(fair, market):

    q = market.inventory
    qmax = market.max_inventory

    inventory_ratio = clamp(
        q / max(qmax, 1),
        -1.0,
        1.0
    )

    skew_ticks = (
        CONFIG["MAX_INVENTORY_SKEW_TICKS"]
        * inventory_ratio
    )

    skew_probability = skew_ticks * market.tick_size

    return fair - skew_probability


def estimate_half_spread(market):

    book_spread = (
        market.best_ask
        - market.best_bid
    ) / market.tick_size

    sigma_ticks = (
        market.sigma_5s
        / market.tick_size
    )

    source_ticks = (
        market.source_dispersion
        / market.tick_size
    )

    half_spread_ticks = max(
        1.5,
        0.5 * book_spread,
        0.75 * sigma_ticks,
        0.75 * source_ticks
    )

    return half_spread_ticks


def calculate_size(
    market,
    execution_price,
    edge_ticks,
    visible_liquidity,
    bankroll
):

    # larger edge -> larger risk allocation
    edge = edge_ticks * market.tick_size

    risk_fraction = clamp(
        0.005 + 0.20 * max(edge - 0.02, 0),
        0.005,
        0.02
    )

    risk_budget = bankroll * risk_fraction

    # conservative worst-case capital/risk per share
    risk_per_share = max(
        execution_price,
        1.0 - execution_price
    )

    risk_qty = (
        risk_budget
        / max(risk_per_share, 0.01)
    )

    liquidity_qty = (
        visible_liquidity
        * CONFIG["MAX_ORDER_LIQUIDITY_FRACTION"]
    )

    return floor(
        min(
            risk_qty,
            liquidity_qty,
            market.remaining_inventory_capacity()
        )
    )


def should_trade_taker_buy(market, fair, now):

    ask = market.best_ask

    if ask is None:
        return False

    fee = fee_per_share(
        side="buy",
        price=ask
    )

    slippage = estimated_slippage(
        market,
        side="buy"
    )

    net_edge = (
        fair
        - ask
        - fee
        - slippage
    )

    edge_ticks = (
        net_edge / market.tick_size
    )

    return (
        edge_ticks
        >= CONFIG["MIN_TAKER_EDGE_TICKS"]
    )


def should_trade_taker_sell(market, fair, now):

    bid = market.best_bid

    if bid is None:
        return False

    fee = fee_per_share(
        side="sell",
        price=bid
    )

    slippage = estimated_slippage(
        market,
        side="sell"
    )

    net_edge = (
        bid
        - fair
        - fee
        - slippage
    )

    edge_ticks = (
        net_edge / market.tick_size
    )

    return (
        edge_ticks
        >= CONFIG["MIN_TAKER_EDGE_TICKS"]
    )


def quote_market(market, fair, now):

    if mm_disabled(market, now):
        cancel_all_quotes(market)
        return

    if minutes_to_settlement(market) <= CONFIG["STOP_MM_MINUTES"]:
        cancel_all_quotes(market)
        return

    center = inventory_center(
        fair,
        market
    )

    half_spread_ticks = estimate_half_spread(market)

    bid = center - (
        half_spread_ticks * market.tick_size
    )

    ask = center + (
        half_spread_ticks * market.tick_size
    )

    bid = round_down_to_tick(bid)
    ask = round_up_to_tick(ask)

    # Never cross the book accidentally.
    if ask >= market.best_ask:
        ask = market.best_ask - market.tick_size

    if bid >= market.best_ask:
        bid = None

    if ask <= market.best_bid:
        ask = None

    # Inventory guardrails
    if market.inventory >= market.max_inventory:
        bid = None

    if market.inventory <= -market.max_inventory:
        ask = None

    # Only improve queue if enough edge remains.
    bid = improve_by_one_tick_if_worthwhile(
        market, bid, fair, side="buy"
    )

    ask = improve_by_one_tick_if_worthwhile(
        market, ask, fair, side="sell"
    )

    replace_quote(
        market,
        side="buy",
        price=bid
    )

    replace_quote(
        market,
        side="sell",
        price=ask
    )


def on_external_move(
    market,
    old_external,
    new_external,
    now
):

    move_ticks = abs(
        new_external - old_external
    ) / market.tick_size

    # Immediate stale-quote protection
    if move_ticks >= 2:
        cancel_all_quotes(market)

    fair = estimate_fair(
        market,
        now
    )

    if fair is None:
        return

    # Re-check executable stale quotes
    if (
        should_trade_taker_buy(
            market, fair, now
        )
    ):
        qty = calculate_size(
            market,
            market.best_ask,
            (
                fair - market.best_ask
            ) / market.tick_size,
            visible_liquidity_at_ask(market),
            BANKROLL
        )

        if qty > 0:
            market_buy(
                market,
                qty
            )
            return

    if (
        should_trade_taker_sell(
            market, fair, now
        )
    ):
        qty = calculate_size(
            market,
            market.best_bid,
            (
                market.best_bid - fair
            ) / market.tick_size,
            visible_liquidity_at_bid(market),
            BANKROLL
        )

        if qty > 0:
            market_sell(
                market,
                qty
            )
            return

    quote_market(
        market,
        fair,
        now
    )


def on_fill(fill, now):

    market = markets[fill.market_id]

    market.inventory += fill.signed_qty

    record_fill(fill)

    # Never leave the old quote sitting there
    cancel_same_side_quote(
        market,
        fill.side
    )

    # Push inventory reduction
    fair = estimate_fair(
        market,
        now
    )

    if fair is not None:

        quote_market(
            market,
            fair,
            now
        )

    # Toxic-fill detection
    if fill.was_passive:

        market.toxic_fills.append({
            "time": now,
            "price": fill.price,
            "side": fill.side,
            "fair_at_fill": fair
        })

        remove_old_toxic_fills(
            market,
            now - CONFIG["TOXIC_WINDOW_SEC"]
        )

        if count_adverse_fills(
            market
        ) >= CONFIG["TOXIC_COUNT"]:

            market.mm_disabled_until = (
                now + CONFIG["MM_COOLDOWN_SEC"]
            )

            cancel_all_quotes(market)


def process_market_update(market, now):

    fair = estimate_fair(
        market,
        now
    )

    if fair is None:
        cancel_all_quotes(market)
        return

    # First priority: exploit executable mispricing
    if should_trade_taker_buy(
        market,
        fair,
        now
    ):

        execute_taker_buy(
            market,
            fair
        )

    elif should_trade_taker_sell(
        market,
        fair,
        now
    ):

        execute_taker_sell(
            market,
            fair
        )

    else:

        quote_market(
            market,
            fair,
            now
        )


async def main():

    load_market_definitions()

    load_external_mappings()

    load_related_market_graph()

    connect_target_websocket()

    connect_external_websockets()

    bootstrap_orderbooks()

    load_recent_trade_history()

    while True:

        event = await next_event()

        now = event.timestamp

        if event.type == "TARGET_BOOK":
            update_target_book(event)
            process_market_update(
                markets[event.market_id],
                now
            )

        elif event.type == "EXTERNAL_BOOK":
            update_external_book(event)

            market_ids = markets_linked_to(
                event.market_id
            )

            for market_id in market_ids:

                market = markets[market_id]

                old = market.external_prob

                new, _ = estimate_external_fair(
                    market,
                    now
                )

                if (
                    old is not None
                    and new is not None
                ):
                    on_external_move(
                        market,
                        old,
                        new,
                        now
                    )

        elif event.type == "RELATED_TRADE":

            update_related_market(event)

            affected = markets_linked_to(
                event.market_id
            )

            for market_id in affected:

                process_market_update(
                    markets[market_id],
                    now
                )

        elif event.type == "FILL":

            on_fill(
                event.fill,
                now
            )

        elif event.type == "SETTLEMENT_WARNING":

            market = markets[
                event.market_id
            ]

            if event.minutes_left <= \
               CONFIG["HARD_FLATTEN_MINUTES"]:

                cancel_all_quotes(market)

                flatten_inventory(
                    market
                )

        elif event.type == "HEARTBEAT":

            check_data_freshness()

            cancel_quotes_for_stale_data()

            enforce_global_risk_limits()

