class ElectionMarketMaker:
    def __init__(self, config):
        self.contracts = load_contract_metadata(config)   # incl. related-market graph
        self.inventory = defaultdict(float)
        self.fair_value = {}
        self.vol = defaultdict(lambda: RollingStd(window=30*60))
        self.last_fill_side = defaultdict(list)
        self.cooldown_until = defaultdict(float)
        self.open_orders = {}

    def on_market_data(self, contract_id, book_update):
        self.update_fair_value(contract_id)
        self.check_arb_relations(contract_id)
        self.maybe_requote(contract_id)

    def update_fair_value(self, cid):
        book = get_book(cid)
        mid = (book.best_bid + book.best_ask) / 2 if book.tight_enough() else None
        ext = get_external_ref_price(cid)          # None if unavailable
        rel = self.implied_from_related(cid)        # None if no relation

        sources, weights = [], []
        for val, w in [(mid, W_MID), (ext, W_EXT), (rel, W_REL)]:
            if val is not None:
                sources.append(val); weights.append(w * self.source_confidence(cid, val))
        f = weighted_avg(sources, weights) if sources else self.fair_value.get(cid, 0.5)
        self.fair_value[cid] = clip(f, 0.01, 0.99)
        self.vol[cid].update(mid or f)

    def implied_from_related(self, cid):
        rel = self.contracts[cid].relations
        if rel.type == "mutually_exclusive_group":
            return None  # handled in check_arb_relations, not fair value
        if rel.type == "conditional":
            parent_f = self.fair_value.get(rel.parent_id)
            return parent_f * rel.conditional_multiplier if parent_f else None
        return None

    def check_arb_relations(self, cid):
        group = self.contracts[cid].mutex_group
        if group:
            asks_sum = sum(get_book(c).best_ask for c in group)
            bids_sum = sum(get_book(c).best_bid for c in group)
            if asks_sum < 1 - ARB_EPS:
                for c in group: self.send_order(c, "buy", get_book(c).best_ask, arb_size(group))
            elif bids_sum > 1 + ARB_EPS:
                for c in group: self.send_order(c, "sell", get_book(c).best_bid, arb_size(group))

        nested = self.contracts[cid].nested_constraint
        if nested and violates_bound(nested):
            trade_both_legs(nested, size=arb_size(nested))

    def maybe_requote(self, cid):
        if time.now() < self.cooldown_until[cid]:
            return
        if not self.is_market_making_candidate(cid):
            self.opportunistic_take(cid)   # just lift/hit if mispriced, no resting quotes
            return

        f = self.fair_value[cid]
        inv = self.inventory[cid]
        sigma = self.vol[cid].value()
        half_spread = max(MIN_SPREAD, K_VOL * sigma) + inventory_penalty(inv)
        res_price = f - GAMMA * inv * sigma**2
        bid = clip(res_price - half_spread, 0.01, 0.99)
        ask = clip(res_price + half_spread, 0.01, 0.99)

        size = base_size(cid) * taper_factor(inv)

        if should_requote(cid, bid, ask):
            cancel_existing_orders(cid)
            if within_limits(cid, "buy", size):
                self.send_order(cid, "buy", bid, size)
            if within_limits(cid, "sell", size):
                self.send_order(cid, "sell", ask, size)

    def opportunistic_take(self, cid):
        f = self.fair_value[cid]
        book = get_book(cid)
        if book.best_ask < f - EDGE_THRESHOLD and within_limits(cid, "buy"):
            self.send_order(cid, "buy", book.best_ask, opportunistic_size(cid))
        elif book.best_bid > f + EDGE_THRESHOLD and within_limits(cid, "sell"):
            self.send_order(cid, "sell", book.best_bid, opportunistic_size(cid))

    def on_fill(self, cid, side, price, qty):
        self.inventory[cid] += qty if side == "buy" else -qty
        self.last_fill_side[cid].append((side, time.now()))
        if adverse_run_detected(self.last_fill_side[cid]):
            self.cooldown_until[cid] = time.now() + COOLDOWN_SEC
        self.maybe_requote(cid)   # immediate reprice/skew

    def periodic_risk_check(self):
        for cid, inv in self.inventory.items():
            if abs(inv) > SOFT_LIMIT[cid]:
                taper_or_unwind(cid)
            if position_age(cid) > T_MAX and no_edge(cid):
                flatten(cid)
        if total_exposure() > MAX_PORTFOLIO_EXPOSURE:
            reduce_riskiest_positions()

    def run(self):
        subscribe(self.on_market_data, self.on_fill)
        while True:
            self.periodic_risk_check()
            sleep(POLL_INTERVAL)
