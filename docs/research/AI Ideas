 # 12\. Complete bot pseudocode

```
# ============================================================
# ELECTION PREDICTION MARKET BOT
# Cross-market fair value + opportunistic market making
# ============================================================

CAPITAL = get_starting_capital()

MAX_POSITION_PCT = 0.02
CAUTION_POSITION_PCT = 0.50

LIQUID_EDGE = 0.025
THIN_EDGE = 0.040

BASE_HALF_SPREAD = 0.015

EXTERNAL_WEIGHT = 0.70
LOCAL_WEIGHT = 0.30

SHOCK_MOVE = 0.04
SHOCK_WINDOW = 30

QUOTE_LIFETIME = 10

MAX_BOOK_FRACTION = 0.15

# ------------------------------------------------------------
# STATE
# ------------------------------------------------------------

markets = {}
positions = {}
orders = {}
external_prices = {}
relationships = {}

trade_stats = {
    # market -> fill statistics
}

# ------------------------------------------------------------
# FAIR VALUE
# ------------------------------------------------------------

def external_fair(market):

    candidates = []

    for external in get_equivalent_external_markets(market):

        if external.age_seconds > 60:
            continue

        if external.liquidity < minimum_liquidity(market):
            continue

        mid = (external.bid + external.ask) / 2

        quality = sqrt(max(external.volume_24h, 1))

        candidates.append((mid, quality))

    if not candidates:
        return None

    return weighted_median(candidates)

def local_fair(market):

    book = markets[market].book

    bid = book.best_bid
    ask = book.best_ask

    if bid is None or ask is None:
        return None

    return (bid + ask) / 2

def related_adjustment(market, base_fair):

    adjustment = 0.0

    for relation in relationships[market]:

        if not relation.is_explicit:
            continue

        other = relation.market

        other_fair = get_fair_value(other)

        if other_fair is None:
            continue

        implied = relation.implied_probability(
            market=market,
            other_probability=other_fair
        )

        adjustment += relation.weight * (
            implied - base_fair
        )

    # Never allow this component to dominate.
    return clip(adjustment, -0.05, +0.05)

def fair_value(market):

    ext = external_fair(market)
    local = local_fair(market)

    if ext is None:
        if local is None:
            return None

        return local

    if local is None:
        return ext

    F = (
        EXTERNAL_WEIGHT * ext
        + LOCAL_WEIGHT * local
    )

    F += related_adjustment(market, F)

    return clip(F, 0.001, 0.999)

# ------------------------------------------------------------
# SHOCK DETECTION
# ------------------------------------------------------------

def information_shock(market):

    history = get_external_history(
        market,
        seconds=SHOCK_WINDOW
    )

    if len(history) < 2:
        return False

    old = history[0].price
    new = history[-1].price

    return abs(new - old) >= SHOCK_MOVE

# ------------------------------------------------------------
# INVENTORY
# ------------------------------------------------------------

def position_limit(market):

    return CAPITAL * MAX_POSITION_PCT

def inventory_fraction(market):

    position_value = abs(
        positions[market] * 1.0
    )

    return position_value / position_limit(market)

def reservation_price(market, F):

    limit = position_limit(market)

    if limit == 0:
        return F

    position_value = positions[market]

    inventory_ratio = (
        position_value / limit
    )

    # Long -> reservation price falls.
    # Short -> reservation price rises.
    return F - inventory_ratio * 0.04

# ------------------------------------------------------------
# EXECUTION EDGE
# ------------------------------------------------------------

def estimated_cost(market):

    return (
        exchange_fee(market)
        + estimated_slippage(market)
    )

def buy_edge(market, F):

    ask = markets[market].book.best_ask

    if ask is None:
        return -999

    return F - ask - estimated_cost(market)

def sell_edge(market, F):

    bid = markets[market].book.best_bid

    if bid is None:
        return -999

    return bid - F - estimated_cost(market)

# ------------------------------------------------------------
# ORDER SIZE
# ------------------------------------------------------------

def order_size(market, edge):

    limit = position_limit(market)

    remaining = (
        limit - abs(positions[market])
    )

    if remaining <= 0:
        return 0

    # Small edge -> small size.
    multiplier = clip(
        (edge - LIQUID_EDGE) / 0.055,
        0.25,
        1.0
    )

    size = remaining * multiplier

    # Never consume too much displayed liquidity.
    book_liquidity = (
        markets[market].book.best_bid_size
        + markets[market].book.best_ask_size
    )

    size = min(
        size,
        MAX_BOOK_FRACTION * book_liquidity
    )

    if information_shock(market):
        size *= 0.50

    return floor_to_contract(size)

# ------------------------------------------------------------
# AGGRESSIVE TRADING
# ------------------------------------------------------------

def evaluate_aggressive_trade(market):

    F = fair_value(market)

    if F is None:
        return

    pos = positions[market]

    # BUY
    edge = buy_edge(market, F)

    if (
        edge >= LIQUID_EDGE
        and pos < position_limit(market)
    ):

        size = order_size(market, edge)

        if size > 0:

            submit_marketable_buy(
                market,
                size
            )

            return

    # SELL
    edge = sell_edge(market, F)

    if (
        edge >= LIQUID_EDGE
        and pos > -position_limit(market)
    ):

        size = order_size(market, edge)

        if size > 0:

            submit_marketable_sell(
                market,
                size
            )

# ------------------------------------------------------------
# PASSIVE QUOTING
# ------------------------------------------------------------

def quote_market(market):

    F = fair_value(market)

    if F is None:
        return

    # Do not market make during an information shock.
    if information_shock(market):
        cancel_quotes(market)
        return

    R = reservation_price(market, F)

    vol = short_term_volatility(market)

    half_spread = (
        BASE_HALF_SPREAD
        + 0.5 * vol
    )

    inv_ratio = inventory_fraction(market)

    # Widen when inventory is large.
    half_spread += 0.01 * inv_ratio

    bid = R - half_spread
    ask = R + half_spread

    # Don't cross the current market accidentally.
    book = markets[market].book

    if book.best_ask is not None:
        bid = min(bid, book.best_ask - tick_size(market))

    if book.best_bid is not None:
        ask = max(ask, book.best_bid + tick_size(market))

    bid = round_to_tick(bid)
    ask = round_to_tick(ask)

    # Inventory limits.
    if positions[market] >= position_limit(market):
        bid = None

    if positions[market] <= -position_limit(market):
        ask = None

    cancel_old_quotes(market)

    if bid is not None:
        submit_limit_buy(
            market,
            price=bid,
            size=passive_size(market, "bid"),
            ttl=QUOTE_LIFETIME
        )

    if ask is not None:
        submit_limit_sell(
            market,
            price=ask,
            size=passive_size(market, "ask"),
            ttl=QUOTE_LIFETIME
        )

# ------------------------------------------------------------
# FILL HANDLER
# ------------------------------------------------------------

def on_fill(fill):

    market = fill.market

    positions[market] += fill.signed_quantity

    record_fill(fill)

    # Re-evaluate immediately.
    cancel_quotes(market)

    F = fair_value(market)

    if F is None:
        return

    # If the fill was favorable, potentially exit.
    if positions[market] > 0:

        if sell_edge(market, F) >= LIQUID_EDGE:
            evaluate_aggressive_trade(market)

    elif positions[market] < 0:

        if buy_edge(market, F) >= LIQUID_EDGE:
            evaluate_aggressive_trade(market)

    # Otherwise establish new inventory-aware quotes.
    quote_market(market)

# ------------------------------------------------------------
# ADVERSE SELECTION MONITOR
# ------------------------------------------------------------

def update_market_maker_parameters():

    for market in markets:

        stats = trade_stats[market]

        five_sec = stats.average_forward_return(5)
        thirty_sec = stats.average_forward_return(30)

        # If our fills consistently precede adverse moves,
        # become less aggressive.
        if (
            five_sec < -0.005
            and thirty_sec < -0.008
        ):

            increase_market_making_spread(market)

        elif (
            five_sec > 0.003
            and thirty_sec > 0.005
        ):

            cautiously_decrease_spread(market)

# ------------------------------------------------------------
# MARKET UPDATE HANDLER
# ------------------------------------------------------------

def on_market_update(update):

    market = update.market

    update_local_book(update)

    # Recompute whenever either local or external information
    # changes materially.
    if material_change(update):

        evaluate_aggressive_trade(market)

        if not information_shock(market):
            quote_market(market)

# ------------------------------------------------------------
# EXTERNAL MARKET UPDATE
# ------------------------------------------------------------

def on_external_update(update):

    affected_markets = map_external_to_local(update)

    for market in affected_markets:

        old_F = cached_fair_value(market)

        invalidate_fair_value_cache(market)

        new_F = fair_value(market)

        if new_F is None:
            continue

        # If fair value moved materially, all quotes are stale.
        if (
            old_F is not None
            and abs(new_F - old_F) >= 0.01
        ):

            cancel_quotes(market)

            evaluate_aggressive_trade(market)

            if not information_shock(market):
                quote_market(market)

# ------------------------------------------------------------
# RISK LOOP
# ------------------------------------------------------------

def risk_loop():

    while True:

        for market in markets:

            # Kill switch conditions.
            if data_is_stale(market):
                cancel_quotes(market)

            if exchange_connection_bad():
                cancel_all_orders()

            if market_resolution_imminent(market):
                cancel_quotes(market)

            # Hard inventory enforcement.
            if abs(positions[market]) >= position_limit(market):

                cancel_quotes(market)

                reduce_position_if_needed(market)

        sleep(1)

# ------------------------------------------------------------
# MAIN
# ------------------------------------------------------------

def main():

    load_market_universe()

    load_related_market_graph()

    connect_exchange_websocket()

    connect_external_market_feeds()

    subscribe_to_relevant_markets()

    start_thread(risk_loop)

    while True:

        event = next_event()

        if event.type == "LOCAL_BOOK":
            on_market_update(event)

        elif event.type == "EXTERNAL_PRICE":
            on_external_update(event)

        elif event.type == "FILL":
            on_fill(event)

        elif event.type == "MARKET_STATUS":
            handle_market_status(event)

        elif event.type == "TIMER":
            update_market_maker_parameters()
```

