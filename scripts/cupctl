#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
PYTHON_BIN="${PREDICTIONS_CUP_PYTHON:-${REPO_ROOT}/.venv/bin/python}"
RUNTIME_ENV="${PREDICTIONS_CUP_RUNTIME_ENV:-${HOME}/.config/predictions-cup/runtime.env}"
[[ -x "${PYTHON_BIN}" ]] || { printf 'ERROR: runtime Python missing: %s\n' "${PYTHON_BIN}" >&2; exit 1; }
[[ -r "${RUNTIME_ENV}" ]] || { printf 'ERROR: runtime env unreadable: %s\n' "${RUNTIME_ENV}" >&2; exit 1; }
cd "${REPO_ROOT}"
exec "${PYTHON_BIN}" -m predictions_cup.fullstack "$@" --env-file "${RUNTIME_ENV}"
