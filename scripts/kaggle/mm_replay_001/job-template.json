{
  "schema_version": 1,
  "action": "run",
  "kernel_dir": "scripts/kaggle/mm_replay_001",
  "kernel": "polyleviathan/mm-replay-001-spread-capture",
  "poll_seconds": 30,
  "timeout_minutes": 330,
  "download_outputs": true,
  "output_file_pattern": "(INPUT_AUDIT\\.(json|md)|005F_TRANSFER_(RESULTS\\.csv|SUMMARY\\.json)|MM_POLICY_RESULTS\\.csv|MM_MARKOUTS\\.csv|MM_TOXICITY_BUCKETS\\.csv|FV_CONVERGENCE\\.csv|LATENCY_SENSITIVITY\\.csv|MARKET_BREAKDOWN\\.csv|FINAL_REPORT\\.md|MASTER_HANDOFF_MM_REPLAY_001\\.md|MM_CANDIDATE_CONFIG\\.json)$",
  "stage_paths": [
    {"source": "src/predictions_cup", "destination": "predictions_cup"},
    {"source": "data/experiments/mm_replay_001/input_manifest.json", "destination": "input_manifest.json"},
    {"source": "data/experiments/experiment_005f/fit_freeze_manifest.json", "destination": "repo_context/fit_freeze_manifest.json"},
    {"source": "data/experiments/experiment_005f/holdout_evidence_manifest.json", "destination": "repo_context/holdout_evidence_manifest.json"},
    {"source": "data/manifests/fills/data_003_manifest.json", "destination": "repo_context/data_003_manifest.json"},
