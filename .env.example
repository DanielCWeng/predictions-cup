# Safe, non-secret defaults for local development.
# Runtime environment variables override values loaded from a local .env file.
PREDICTIONS_CUP_ENVIRONMENT=development
PREDICTIONS_CUP_LOG_LEVEL=INFO
PREDICTIONS_CUP_SIG_API_BASE_URL=https://www.thesuper.market/api/v1
PREDICTIONS_CUP_TRADING_ENABLED=false

# BUILD-009 execution defaults. SHADOW is the default; LIVE requires every
# explicit gate below plus a trade credential and explicit tournament context.
PREDICTIONS_CUP_EXECUTION_MODE=SHADOW
PREDICTIONS_CUP_GLOBAL_KILL_SWITCH=true
PREDICTIONS_CUP_EXECUTION_JOURNAL_PATH=data/execution_journal.sqlite3
PREDICTIONS_CUP_RISK_MAX_STATE_AGE_MS=1000
# Required before LIVE can start:
# PREDICTIONS_CUP_RISK_MAX_ORDER_SIZE=10
# PREDICTIONS_CUP_RISK_MAX_GROSS_EXPOSURE=100
# PREDICTIONS_CUP_RISK_MAX_PER_MARKET_EXPOSURE=25
# PREDICTIONS_CUP_RISK_MAX_OPEN_ORDER_EXPOSURE=50
# PREDICTIONS_CUP_RISK_MAX_CONCURRENT_OPEN_ORDERS=10

# Optional tournament context. Uncomment and set when known.
# PREDICTIONS_CUP_TOURNAMENT_ID=your-tournament-id
# PREDICTIONS_CUP_TOURNAMENT_SLUG=your-tournament-slug

# Accepted BUILD-006 SIG Realtime capture. Explicit invocation only.
PREDICTIONS_CUP_SIG_REALTIME_STORAGE_PATH=data/sig_realtime.sqlite3
PREDICTIONS_CUP_SIG_REALTIME_BOOK_DEPTH=20
# Optional comma-separated authoritative depth set. Empty/unset = no tracked depth.
PREDICTIONS_CUP_SIG_REALTIME_TRACKED_EXCHANGE_IDS=
PREDICTIONS_CUP_SIG_REALTIME_OPEN_BOOK_REFRESH_SECONDS=30
PREDICTIONS_CUP_SIG_REALTIME_TOKEN_REFRESH_MARGIN_SECONDS=300
PREDICTIONS_CUP_SIG_REALTIME_RETENTION_DAYS=14

# EXPERIMENT-001A read-only Polymarket capture. Disabled unless explicitly run/enabled.
PREDICTIONS_CUP_POLYMARKET_CAPTURE_ENABLED=false
PREDICTIONS_CUP_POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
PREDICTIONS_CUP_POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
PREDICTIONS_CUP_POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PREDICTIONS_CUP_POLYMARKET_SNAPSHOT_INTERVAL_SECONDS=1
PREDICTIONS_CUP_POLYMARKET_BOOK_DEPTH=20
PREDICTIONS_CUP_POLYMARKET_DEPTH_SNAPSHOT_INTERVAL_SECONDS=60
PREDICTIONS_CUP_POLYMARKET_GAMMA_PAGE_LIMIT=100
PREDICTIONS_CUP_POLYMARKET_GAMMA_REFRESH_SECONDS=300
# Small operational SQLite only: metadata + health.
PREDICTIONS_CUP_POLYMARKET_STORAGE_PATH=data/polymarket_operational.sqlite3
# High-frequency research streams: immutable ZSTD Parquet shards.
PREDICTIONS_CUP_POLYMARKET_RESEARCH_PATH=data/polymarket_research
PREDICTIONS_CUP_POLYMARKET_PARQUET_SHARD_SECONDS=60
PREDICTIONS_CUP_POLYMARKET_PARQUET_MAX_ROWS_PER_SHARD=100000
PREDICTIONS_CUP_POLYMARKET_UNIVERSE=us_elections_2026
# Required by the supervised systemd service. Supply only IDs from the accepted
# SIG ↔ Polymarket mapping universe; accepts market, condition, or token IDs.
PREDICTIONS_CUP_POLYMARKET_SUPERVISED_IDS=
# PREDICTIONS_CUP_POLYMARKET_INCLUDE_IDS=market-or-condition-or-token-id,...
# PREDICTIONS_CUP_POLYMARKET_EXCLUDE_IDS=market-or-condition-or-token-id,...

# Credentials are intentionally omitted. Supply them only through local .env/runtime configuration.
# PREDICTIONS_CUP_SIG_READ_CREDENTIAL
# PREDICTIONS_CUP_SIG_TRADE_CREDENTIAL
# No Polymarket credential is used by EXPERIMENT-001A.

# AWS EC2 runtime secret layout. BUILD-007 systemd services load runtime.env only.
# Never commit secret values.
# Production/runtime secrets are stored outside the repository on the EC2 host:
#   ~/.config/predictions-cup/runtime.env
#       PREDICTIONS_CUP_SIG_READ_CREDENTIAL=...
#       PREDICTIONS_CUP_TRADING_ENABLED=false
#       PREDICTIONS_CUP_EXECUTION_MODE=SHADOW
#       PREDICTIONS_CUP_GLOBAL_KILL_SWITCH=true
#   ~/.config/predictions-cup/trade.env
#       PREDICTIONS_CUP_SIG_TRADE_CREDENTIAL=...
#
# Expected permissions:
#   ~/.config/predictions-cup/          mode 700
#   runtime.env and trade.env           mode 600
#
# Operational rule:
# - read-only/research processes load runtime.env only;
# - trade.env is deliberately not sourced during read-only operation;
# - future execution/systemd code must load trade.env only when an explicitly approved
#   trading path requires it;
# - never print, log, copy into Git, or expose either credential value.
