# Safe, non-secret defaults for local development.
# Runtime environment variables override values loaded from a local .env file.
PREDICTIONS_CUP_ENVIRONMENT=development
PREDICTIONS_CUP_LOG_LEVEL=INFO
PREDICTIONS_CUP_SIG_API_BASE_URL=https://www.thesuper.market/api/v1
PREDICTIONS_CUP_TRADING_ENABLED=false

# BUILD-009 execution defaults. SHADOW is the default; LIVE requires every
# explicit gate below plus a trade credential and explicit tournament context.
PREDICTIONS_CUP_EXECUTION_MODE=SHADOW
PREDICTIONS_CUP_GLOBAL_KILL_SWITCH=true
PREDICTIONS_CUP_EXECUTION_JOURNAL_PATH=data/execution_journal.sqlite3
PREDICTIONS_CUP_RISK_MAX_STATE_AGE_MS=1000
# Required before LIVE can start:
# PREDICTIONS_CUP_RISK_MAX_ORDER_SIZE=10
# PREDICTIONS_CUP_RISK_MAX_GROSS_EXPOSURE=100
# PREDICTIONS_CUP_RISK_MAX_PER_MARKET_EXPOSURE=25
# PREDICTIONS_CUP_RISK_MAX_OPEN_ORDER_EXPOSURE=50
# PREDICTIONS_CUP_RISK_MAX_CONCURRENT_OPEN_ORDERS=10
# RISK-002 capital control. SHADOW/research may leave this disabled; LIVE requires
# it enabled and requires deliberate positive session-loss + drawdown limits below.
PREDICTIONS_CUP_RISK_CAPITAL_CONTROL_ENABLED=false
PREDICTIONS_CUP_RISK_STATE_PATH=data/risk_002.sqlite3
# Optional versioned JSON document for explicit correlated-event grouping.
# PREDICTIONS_CUP_RISK_EXPOSURE_GROUPS_PATH=config/risk_exposure_groups.json
PREDICTIONS_CUP_RISK_PROFILE_NAME=competition
PREDICTIONS_CUP_RISK_PROFILE_VERSION=risk-002-v1
PREDICTIONS_CUP_RISK_PROFILE_MODE=STANDARD
# EXPLORATORY still runs the global hard caps above. When enabled, configure the
# complete exploratory base cap set below; optional advanced exploratory caps
# may be added as needed.
# PREDICTIONS_CUP_RISK_EXPLORATORY_MAX_ORDER_SIZE=2
# PREDICTIONS_CUP_RISK_EXPLORATORY_MAX_GROSS_EXPOSURE=20
# PREDICTIONS_CUP_RISK_EXPLORATORY_MAX_PER_MARKET_EXPOSURE=5
# PREDICTIONS_CUP_RISK_EXPLORATORY_MAX_OPEN_ORDER_EXPOSURE=10
# PREDICTIONS_CUP_RISK_EXPLORATORY_MAX_CONCURRENT_OPEN_ORDERS=4
# PREDICTIONS_CUP_RISK_EXPLORATORY_MAX_PER_STRATEGY_EXPOSURE=10
# PREDICTIONS_CUP_RISK_EXPLORATORY_MAX_EVENT_GROUP_EXPOSURE=15
# PREDICTIONS_CUP_RISK_EXPLORATORY_MAX_TOURNAMENT_EXPOSURE=20
PREDICTIONS_CUP_RISK_MAX_ACCOUNT_AGE_MS=2000
PREDICTIONS_CUP_RISK_MAX_MARK_AGE_MS=12000
# Optional advanced exposure caps:
# PREDICTIONS_CUP_RISK_MAX_PER_STRATEGY_EXPOSURE=25
# PREDICTIONS_CUP_RISK_MAX_EVENT_GROUP_EXPOSURE=50
# PREDICTIONS_CUP_RISK_MAX_TOURNAMENT_EXPOSURE=100
# Required for LIVE; intentionally no production default is invented:
# PREDICTIONS_CUP_RISK_SESSION_LOSS_LIMIT=20
# PREDICTIONS_CUP_RISK_DRAWDOWN_LIMIT=15

# MAKE-001 modular market maker. Disabled by default.
PREDICTIONS_CUP_MAKER_ENABLED=false
PREDICTIONS_CUP_MAKER_MAPPING_PATH=data/mappings/sig_polymarket_2026.json
PREDICTIONS_CUP_MAKER_MAX_ABS_INVENTORY=10
PREDICTIONS_CUP_MAKER_BASE_SIZE=2
PREDICTIONS_CUP_MAKER_MINIMUM_SIZE=1
PREDICTIONS_CUP_MAKER_BASE_HALF_SPREAD_TICKS=1
PREDICTIONS_CUP_MAKER_INVENTORY_RISK_AVERSION=0.02
PREDICTIONS_CUP_MAKER_UNCERTAINTY_MULTIPLIER=1
PREDICTIONS_CUP_MAKER_VOLATILITY_MULTIPLIER=0.5
PREDICTIONS_CUP_MAKER_TOXICITY_HALF_SPREAD_TICKS=4
PREDICTIONS_CUP_MAKER_MAX_BBO_AGE_MS=12000
PREDICTIONS_CUP_MAKER_MAX_FV_AGE_MS=1000
PREDICTIONS_CUP_MAKER_MAX_ACCOUNT_AGE_MS=2000
PREDICTIONS_CUP_MAKER_MAX_INVENTORY_AGE_MS=2000
PREDICTIONS_CUP_MAKER_MAX_SIGNAL_AGE_MS=1000
PREDICTIONS_CUP_MAKER_REQUIRE_TRUSTED_DEPTH=false
PREDICTIONS_CUP_MAKER_MAX_DEPTH_AGE_MS=35000
PREDICTIONS_CUP_MAKER_MIN_REPLACE_TICKS=1
PREDICTIONS_CUP_MAKER_MIN_REPLACE_SIZE=1
PREDICTIONS_CUP_MAKER_MIN_REQUOTE_INTERVAL_MS=0

# SHADOW-002 / LIVE-LEARN-001 research control plane. No order-write capability.
PREDICTIONS_CUP_SHADOW_ENABLED=false
PREDICTIONS_CUP_SHADOW_JOURNAL_PATH=data/shadow_002/events.jsonl
PREDICTIONS_CUP_SHADOW_CAPTURE_MIRROR_ENABLED=true
PREDICTIONS_CUP_LIVE_LEARN_ENABLED=false
PREDICTIONS_CUP_LIVE_LEARN_OUTCOME_PATH=data/live_learn/outcomes.jsonl
PREDICTIONS_CUP_LIVE_LEARN_REPORT_PATH=data/live_learn/reports
PREDICTIONS_CUP_LIVE_LEARN_QUEUE_CAPACITY=200000
PREDICTIONS_CUP_LIVE_LEARN_EVIDENCE_GRACE_SECONDS=5
PREDICTIONS_CUP_LIVE_LEARN_MAX_EVIDENCE_AGE_SECONDS=15

# Optional tournament context. Uncomment and set when known.
# PREDICTIONS_CUP_TOURNAMENT_ID=your-tournament-id
# PREDICTIONS_CUP_TOURNAMENT_SLUG=your-tournament-slug

# Accepted BUILD-006 SIG Realtime capture. Explicit invocation only.
PREDICTIONS_CUP_SIG_REALTIME_STORAGE_PATH=data/sig_realtime.sqlite3
# CAPTURE-001 immutable high-frequency SIG research evidence.
PREDICTIONS_CUP_SIG_RESEARCH_PATH=data/sig_research
PREDICTIONS_CUP_SIG_CAPTURE_QUEUE_MAX=200000
PREDICTIONS_CUP_SIG_CAPTURE_PARQUET_SHARD_SECONDS=60
PREDICTIONS_CUP_SIG_CAPTURE_PARQUET_MAX_ROWS_PER_SHARD=100000
PREDICTIONS_CUP_SIG_REALTIME_BOOK_DEPTH=20
# Optional comma-separated authoritative depth set. Empty/unset = no tracked depth.
PREDICTIONS_CUP_SIG_REALTIME_TRACKED_EXCHANGE_IDS=
PREDICTIONS_CUP_SIG_REALTIME_OPEN_BOOK_REFRESH_SECONDS=30
PREDICTIONS_CUP_SIG_REALTIME_TOKEN_REFRESH_MARGIN_SECONDS=300
PREDICTIONS_CUP_SIG_REALTIME_RETENTION_DAYS=14

# EXPERIMENT-001A read-only Polymarket capture. Disabled unless explicitly run/enabled.
PREDICTIONS_CUP_POLYMARKET_CAPTURE_ENABLED=false
PREDICTIONS_CUP_POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
PREDICTIONS_CUP_POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
PREDICTIONS_CUP_POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PREDICTIONS_CUP_POLYMARKET_SNAPSHOT_INTERVAL_SECONDS=1
PREDICTIONS_CUP_POLYMARKET_BOOK_DEPTH=20
PREDICTIONS_CUP_POLYMARKET_DEPTH_SNAPSHOT_INTERVAL_SECONDS=60
PREDICTIONS_CUP_POLYMARKET_GAMMA_PAGE_LIMIT=100
PREDICTIONS_CUP_POLYMARKET_GAMMA_REFRESH_SECONDS=300
# Small operational SQLite only: metadata + health.
PREDICTIONS_CUP_POLYMARKET_STORAGE_PATH=data/polymarket_operational.sqlite3
# High-frequency research streams: immutable ZSTD Parquet shards.
PREDICTIONS_CUP_POLYMARKET_RESEARCH_PATH=data/polymarket_research
PREDICTIONS_CUP_POLYMARKET_PARQUET_SHARD_SECONDS=60
PREDICTIONS_CUP_POLYMARKET_PARQUET_MAX_ROWS_PER_SHARD=100000
PREDICTIONS_CUP_POLYMARKET_UNIVERSE=us_elections_2026
# Required by the supervised systemd service. Generate the strict token set with:
#   python -m predictions_cup.external.polymarket.supervised_universe
# This unions accepted EXACT+DERIVED mapping tokens with the explicit capture-only
# R3 structural-shadow YES-token allowlist. No broad election fallback is enabled.
PREDICTIONS_CUP_POLYMARKET_SUPERVISED_IDS=
# PREDICTIONS_CUP_POLYMARKET_INCLUDE_IDS=market-or-condition-or-token-id,...
# PREDICTIONS_CUP_POLYMARKET_EXCLUDE_IDS=market-or-condition-or-token-id,...

# Credentials are intentionally omitted. Supply them only through local .env/runtime configuration.
# PREDICTIONS_CUP_SIG_READ_CREDENTIAL
# PREDICTIONS_CUP_SIG_TRADE_CREDENTIAL
# No Polymarket credential is used by EXPERIMENT-001A.

# AWS EC2 runtime secret layout. BUILD-007 systemd services load runtime.env only.
# Never commit secret values.
# Production/runtime secrets are stored outside the repository on the EC2 host:
#   ~/.config/predictions-cup/runtime.env
#       PREDICTIONS_CUP_SIG_READ_CREDENTIAL=...
#       PREDICTIONS_CUP_TRADING_ENABLED=false
#       PREDICTIONS_CUP_EXECUTION_MODE=SHADOW
#       PREDICTIONS_CUP_GLOBAL_KILL_SWITCH=true
#   ~/.config/predictions-cup/trade.env
#       PREDICTIONS_CUP_SIG_TRADE_CREDENTIAL=...
#
# Expected permissions:
#   ~/.config/predictions-cup/          mode 700
#   runtime.env and trade.env           mode 600
#
# Operational rule:
# - read-only/research processes load runtime.env only;
# - trade.env is deliberately not sourced during read-only operation;
# - future execution/systemd code must load trade.env only when an explicitly approved
#   trading path requires it;
# - never print, log, copy into Git, or expose either credential value.

# FULLSTACK-001 launch rehearsal / composed runtime.
# The standard installer remains SHADOW-only and refuses LIVE/trade credentials.
PREDICTIONS_CUP_FULLSTACK_PROFILE=REHEARSAL
PREDICTIONS_CUP_FULLSTACK_CONFIG_SCHEMA_VERSION=fullstack-001-v1
PREDICTIONS_CUP_FULLSTACK_STATUS_DIR=data/runtime/status
PREDICTIONS_CUP_FULLSTACK_SNAPSHOT_PATH=data/runtime/launch_snapshot.json
PREDICTIONS_CUP_FULLSTACK_EVIDENCE_ROOT=data/runtime/rehearsals
PREDICTIONS_CUP_FULLSTACK_MAX_FEED_AGE_SECONDS=60
PREDICTIONS_CUP_FULLSTACK_MAX_PROVIDER_AGE_SECONDS=5
PREDICTIONS_CUP_FULLSTACK_QUEUE_WARN_FRACTION=0.75
PREDICTIONS_CUP_FULLSTACK_QUEUE_BLOCK_FRACTION=0.95
PREDICTIONS_CUP_FULLSTACK_WARN_FREE_DISK_GIB=8
PREDICTIONS_CUP_FULLSTACK_MIN_FREE_DISK_GIB=3
# Canonical in-process LIVE-LEARN enablement is PREDICTIONS_CUP_LIVE_LEARN_ENABLED
# above. These FULLSTACK flags are retained only for explicit adapter/capability
# overrides and future EXTERNAL_SERVICE providers.
PREDICTIONS_CUP_FULLSTACK_LIVE_LEARN_ENABLED=false
PREDICTIONS_CUP_FULLSTACK_OBSERVE_ENABLED=false
# Accepted #67/#66 production ownership is in-process.
PREDICTIONS_CUP_FULLSTACK_LIVE_LEARN_MODE=IN_PROCESS
PREDICTIONS_CUP_FULLSTACK_OBSERVE_MODE=IN_PROCESS
PREDICTIONS_CUP_FULLSTACK_LIVE_LEARN_OWNER_SERVICES=predictions-cup-maker.service
PREDICTIONS_CUP_FULLSTACK_OBSERVE_OWNER_SERVICES=predictions-cup-maker.service
PREDICTIONS_CUP_FULLSTACK_ALLOW_FIXTURES=false
# Only for an explicitly authoritative EXTERNAL_SERVICE provider:
# PREDICTIONS_CUP_LIVE_LEARN_COMMAND=/absolute/command --args
# PREDICTIONS_CUP_OBSERVE_COMMAND=/absolute/command --args

# Final real-rehearsal provider hooks. These must invoke merged real runtime
# exercises that emit one JSON object with evidence_state=REAL_PASS,
# provider_mode=real and economic_order_sent=false.
# PREDICTIONS_CUP_RISK_HALT_EXERCISE_COMMAND=/absolute/real-risk-exercise
# PREDICTIONS_CUP_MAKER_KILL_CANCEL_EXERCISE_COMMAND=/absolute/real-maker-kill-exercise
# PREDICTIONS_CUP_EXECUTION_RECOVERY_EXERCISE_COMMAND=/absolute/real-recovery-exercise
PREDICTIONS_CUP_FULLSTACK_EXERCISE_TIMEOUT_SECONDS=90
# Reboot is never implied by --require-real. Set only after explicit authorization.
PREDICTIONS_CUP_FULLSTACK_REBOOT_AUTHORIZED=false
