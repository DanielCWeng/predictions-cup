[Unit]
Description=Predictions Cup durable failure alert for %i

[Service]
Type=oneshot
User=@@RUNTIME_USER@@
WorkingDirectory=@@REPO_ROOT@@
EnvironmentFile=-@@RUNTIME_ENV@@
Environment=PYTHONUNBUFFERED=1
UnsetEnvironment=PREDICTIONS_CUP_SIG_TRADE_CREDENTIAL
ExecStart=@@PYTHON_BIN@@ -m predictions_cup.fullstack alert --unit %i --runtime-env-only
UMask=0077
NoNewPrivileges=true
