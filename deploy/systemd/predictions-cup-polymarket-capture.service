# BUILD-007 systemd template. Render with scripts/install_runtime_services.sh.
[Unit]
Description=Predictions Cup read-only Polymarket capture
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@@RUNTIME_USER@@
WorkingDirectory=@@REPO_ROOT@@
EnvironmentFile=@@RUNTIME_ENV@@
Environment=PYTHONUNBUFFERED=1
ExecStart=@@PYTHON_BIN@@ -m predictions_cup.external.polymarket.recorder --runtime-env-only
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
