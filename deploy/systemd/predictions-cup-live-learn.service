# FULLSTACK-001 systemd template. Render with scripts/install_runtime_services.sh.
[Unit]
Description=Predictions Cup LIVE-LEARN capability adapter
Wants=network-online.target
After=network-online.target predictions-cup-maker.service
PartOf=predictions-cup-runtime.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
User=@@RUNTIME_USER@@
WorkingDirectory=@@REPO_ROOT@@
EnvironmentFile=@@RUNTIME_ENV@@
Environment=PYTHONUNBUFFERED=1
UnsetEnvironment=PREDICTIONS_CUP_SIG_TRADE_CREDENTIAL
ExecStart=@@PYTHON_BIN@@ -m predictions_cup.runtime.adapter_service live-learn --runtime-env-only
Restart=on-failure
RestartSec=5s
RestartSteps=4
RestartMaxDelaySec=60s
KillSignal=SIGTERM
TimeoutStopSec=45s
SendSIGKILL=no
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=predictions-cup-runtime.target
