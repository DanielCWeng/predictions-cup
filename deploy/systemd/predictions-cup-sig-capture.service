# BUILD-007/FULLSTACK-001 systemd template. Render with scripts/install_runtime_services.sh.
[Unit]
Description=Predictions Cup read-only SIG capture
Wants=network-online.target
After=network-online.target
PartOf=predictions-cup-runtime.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@@RUNTIME_USER@@
WorkingDirectory=@@REPO_ROOT@@
EnvironmentFile=@@RUNTIME_ENV@@
Environment=PYTHONUNBUFFERED=1
UnsetEnvironment=PREDICTIONS_CUP_SIG_TRADE_CREDENTIAL
ExecStart=@@PYTHON_BIN@@ -m predictions_cup.sig.capture --runtime-env-only
Restart=on-failure
RestartSec=5s
RestartSteps=4
RestartMaxDelaySec=60s
KillSignal=SIGTERM
TimeoutStopSec=60s
SendSIGKILL=no
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=predictions-cup-runtime.target
