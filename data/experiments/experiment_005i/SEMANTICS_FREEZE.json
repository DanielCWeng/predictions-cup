    },
    "V2": {
      "field": "timestamp_received",
      "precision": "milliseconds",
      "same_time_policy": "batch/fail closed for sequential claims",
      "payload": "typed event rows; depth encoded as strings"
    },
    "AG6": {
      "field": "timestamp_received",
      "precision": "milliseconds",
      "same_time_policy": "batch/fail closed for sequential claims",
      "payload": "V2-like typed event rows; independent source label"
    },
    "V3": {
      "field": "timestamp_received",
      "precision": "microseconds",
      "same_time_policy": "timestamp_received controls; sequence is provenance only until independently proven to be a global event clock",
      "payload": "typed events with nested depth"
    }
  },
  "V3_fields_verified": [
    "event_type",
    "timestamp_received",
